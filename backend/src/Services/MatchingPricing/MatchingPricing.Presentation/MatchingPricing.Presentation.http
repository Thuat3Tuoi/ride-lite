@baseUrl = http://localhost:5002

### 0. Health Check
GET {{baseUrl}}/matching/health
Accept: application/json

### =========================================================================
### 1. DRIVERS
### =========================================================================

### 1.1 Create Driver
# @name createDriver
POST {{baseUrl}}/api/drivers
Content-Type: application/json

{
  "fullName": "Le Van Driver",
  "phoneNumber": "0901234567",
  "dateOfBirth": "1990-01-01",
  "status": "offline"
}

@driverId = {{createDriver.response.body.id}}

### 1.2 Get Driver by Id
GET {{baseUrl}}/api/drivers/{{driverId}}

### 1.3 Driver Goes Online (Available)
POST {{baseUrl}}/api/drivers/{{driverId}}/status
Content-Type: application/json

{
  "status": "available"
}

### 1.4 Update Driver Location (GPS)
POST {{baseUrl}}/api/drivers/{{driverId}}/location
Content-Type: application/json

{
  "latitude": 10.7725,
  "longitude": 106.6980
}

### 1.5 Find Nearby Drivers for Matching
GET {{baseUrl}}/api/drivers/nearby?pickupLatitude=10.7730&pickupLongitude=106.6990&radiusKm=5&limit=10

### =========================================================================
### 2. ASSIGNMENTS
### =========================================================================

### 2.1 Create Assignment Offer
# @name createAssignment
POST {{baseUrl}}/api/assignments
Content-Type: application/json

{
  "tripId": 1001,
  "driverId": {{driverId}},
  "offerDuration": "00:01:00"
}

@assignmentId = {{createAssignment.response.body.id}}

### 2.2 Get Assignments by Trip ID
GET {{baseUrl}}/api/assignments/trip/1001

### 2.3 Driver Accepts Assignment
POST {{baseUrl}}/api/assignments/{{assignmentId}}/accept
Content-Type: application/json

{
  "driverId": {{driverId}}
}

### =========================================================================
### 3. PRICING
### =========================================================================

### 3.1 Estimate Trip Fare
POST {{baseUrl}}/api/pricing/estimate
Content-Type: application/json

{
  "pickupLatitude": 10.7725,
  "pickupLongitude": 106.6980,
  "dropoffLatitude": 10.7950,
  "dropoffLongitude": 106.7218
}
