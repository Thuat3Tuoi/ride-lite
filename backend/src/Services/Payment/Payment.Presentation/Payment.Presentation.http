@baseUrl = http://localhost:5003

### 0. Health Check
GET {{baseUrl}}/payment/health
Accept: application/json

### =========================================================================
### 1. PAYMENT PROVIDERS
### =========================================================================

### 1.1 Create Provider
# @name createProvider
POST {{baseUrl}}/api/payment-providers
Content-Type: application/json

{
  "code": "MOMO_PROVIDER",
  "name": "MoMo E-Wallet Gateway",
  "handlerType": "Momo",
  "active": true
}

### Lưu ID từ request trên
@providerId = {{createProvider.response.body.id}}

### 1.2 Get Provider by Id
GET {{baseUrl}}/api/payment-providers/{{providerId}}

### 1.3 Get Active Providers
GET {{baseUrl}}/api/payment-providers/active

### 1.4 Deactivate Provider
PUT {{baseUrl}}/api/payment-providers/{{providerId}}/deactivate

### 1.5 Activate Provider
PUT {{baseUrl}}/api/payment-providers/{{providerId}}/activate

### =========================================================================
### 2. PAYMENT METHODS
### =========================================================================

### 2.1 Create Payment Method
# @name createMethod
POST {{baseUrl}}/api/payment-methods
Content-Type: application/json

{
  "code": "E_WALLET",
  "name": "Ví điện tử",
  "active": true
}

@methodId = {{createMethod.response.body.id}}

### 2.2 Get Payment Method by Id
GET {{baseUrl}}/api/payment-methods/{{methodId}}

### 2.3 Get Active Payment Methods
GET {{baseUrl}}/api/payment-methods/active

### 2.4 Deactivate Method
PUT {{baseUrl}}/api/payment-methods/{{methodId}}/deactivate

### 2.5 Activate Method
PUT {{baseUrl}}/api/payment-methods/{{methodId}}/activate

### =========================================================================
### 3. PAYMENT OPTIONS
### =========================================================================

### 3.1 Create Payment Option
# @name createOption
POST {{baseUrl}}/api/payment-options
Content-Type: application/json

{
  "methodId": {{methodId}},
  "providerId": {{providerId}},
  "code": "MOMO_WALLET_APP",
  "name": "Thanh toán qua ứng dụng MoMo",
  "active": true
}

@optionId = {{createOption.response.body.id}}

### 3.2 Get Payment Option by Id
GET {{baseUrl}}/api/payment-options/{{optionId}}

### 3.3 Get Active Payment Options
GET {{baseUrl}}/api/payment-options/active

### 3.4 Get Payment Options by Method Id
GET {{baseUrl}}/api/payment-options/method/{{methodId}}

### 3.5 Deactivate Option
PUT {{baseUrl}}/api/payment-options/{{optionId}}/deactivate

### 3.6 Activate Option
PUT {{baseUrl}}/api/payment-options/{{optionId}}/activate

### =========================================================================
### 4. PAYMENTS
### =========================================================================

### 4.1 Create Payment
# @name createPayment
POST {{baseUrl}}/api/payments
Content-Type: application/json

{
  "tripId": 1001,
  "paymentOptionId": {{optionId}},
  "amount": 150000.00,
  "idempotencyKey": "PAY-IDEM-001",
  "providerId": {{providerId}}
}

@paymentId = {{createPayment.response.body.id}}

### 4.2 Get Payment by Id
GET {{baseUrl}}/api/payments/{{paymentId}}

### 4.3 Get Payment by Trip Id
GET {{baseUrl}}/api/payments/trip/1001

### 4.4 Process Payment
POST {{baseUrl}}/api/payments/{{paymentId}}/process

### 4.5 Complete Payment
POST {{baseUrl}}/api/payments/{{paymentId}}/complete
Content-Type: application/json

{
  "providerTransactionId": "MOMO_TXN_998877",
  "gatewayToken": "tok_momo_sample",
  "resolvedProviderId": {{providerId}}
}

### 4.6 Create Payment to Cancel
# @name createPaymentCancel
POST {{baseUrl}}/api/payments
Content-Type: application/json

{
  "tripId": 1002,
  "paymentOptionId": {{optionId}},
  "amount": 80000.00,
  "idempotencyKey": "PAY-IDEM-002",
  "providerId": {{providerId}}
}

@cancelPaymentId = {{createPaymentCancel.response.body.id}}

### 4.7 Cancel Payment
POST {{baseUrl}}/api/payments/{{cancelPaymentId}}/cancel
Content-Type: application/json

{
  "reason": "Khách đổi chuyến xe"
}

### =========================================================================
### 5. REFUNDS
### =========================================================================

### 5.1 Create Refund
# @name createRefund
POST {{baseUrl}}/api/refunds
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "amount": 50000.00,
  "idempotencyKey": "REF-IDEM-001",
  "reason": "Hoàn tiền cước chuyến đi"
}

@refundId = {{createRefund.response.body.id}}

### 5.2 Get Refund by Id
GET {{baseUrl}}/api/refunds/{{refundId}}

### 5.3 Get Refunds by Payment Id
GET {{baseUrl}}/api/refunds/payment/{{paymentId}}

### 5.4 Process Refund
POST {{baseUrl}}/api/refunds/{{refundId}}/process

### 5.5 Complete Refund
POST {{baseUrl}}/api/refunds/{{refundId}}/complete
Content-Type: application/json

{
  "providerRefundId": "MOMO_REFUND_TXN_112233"
}

### =========================================================================
### 6. LEDGER ENTRIES
### =========================================================================

### 6.1 Create Payment Ledger Entry
POST {{baseUrl}}/api/ledger-entries/payment
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "amount": 150000.00,
  "debitAccount": "MOMO_CLEARING",
  "creditAccount": "TRIP_REVENUE"
}

### 6.2 Create Refund Ledger Entry
POST {{baseUrl}}/api/ledger-entries/refund
Content-Type: application/json

{
  "paymentId": {{paymentId}},
  "refundId": {{refundId}},
  "amount": 50000.00,
  "debitAccount": "REFUND_EXPENSE",
  "creditAccount": "MOMO_CLEARING"
}

### 6.3 Get Ledger Entries by Payment Id
GET {{baseUrl}}/api/ledger-entries/payment/{{paymentId}}

### 6.4 Get Ledger Entries by Refund Id
GET {{baseUrl}}/api/ledger-entries/refund/{{refundId}}
