{
  "ReverseProxy": {
    "Routes": {
      "trip-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/thuatdv/trip/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/thuatdv"
          }
        ]
      },
      "matching-pricing-route": {
        "ClusterId": "matching-pricing-cluster",
        "Match": {
          "Path": "/matching-pricing/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payment/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "trip-cluster": {
        "Destinations": {
          "trip-service": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "matching-pricing-cluster": {
        "Destinations": {
          "matching-pricing-service": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
