{
  "ReverseProxy": {
    "Routes": {
      "trip-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/api/trip/{**catch-all}"
        }
      },
      "matching-route": {
        "ClusterId": "matching-pricing-cluster",
        "Match": {
          "Path": "/api/matching/{**catch-all}"
        }
      },
      "matching-pricing-alias-route": {
        "ClusterId": "matching-pricing-cluster",
        "Match": {
          "Path": "/api/matching-pricing/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/matching/{**remainder}" }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "trip-short-prefix-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/trip/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/trip/{**remainder}" }
        ]
      },
      "matching-short-prefix-route": {
        "ClusterId": "matching-pricing-cluster",
        "Match": {
          "Path": "/matching/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/matching/{**remainder}" }
        ]
      },
      "payment-short-prefix-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payment/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/payment/{**remainder}" }
        ]
      }
    },
    "Clusters": {
      "trip-cluster": {
        "Destinations": {
          "trip-service": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "matching-pricing-cluster": {
        "Destinations": {
          "matching-pricing-service": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
